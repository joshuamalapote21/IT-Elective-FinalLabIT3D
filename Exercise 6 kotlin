@Composable
fun Exercise6Screen() {
    val context = LocalContext.current

    // States
    var name by remember { mutableStateOf("") }
    var toggleState by remember { mutableStateOf(false) }
    var currentImageIndex by remember { mutableStateOf(0) }
    val images = listOf(R.drawable.idonow, R.drawable.monsters)

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp)
            .background(Color.White),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        // Title
        Text(
            text = "Welcome to My App",
            fontSize = 24.sp,
            color = Color.Black,
            modifier = Modifier.padding(bottom = 24.dp),
        )

        // Name Input
        OutlinedTextField(
            value = name,
            onValueChange = { name = it },
            label = { Text("Enter your name") },
            placeholder = { Text("Type here...") },
            modifier = Modifier
                .fillMaxWidth()
                .padding(bottom = 16.dp)
        )

        // Static Image
        Image(
            painter = painterResource(id = R.drawable.idonow),
            contentDescription = "App logo image",
            modifier = Modifier
                .size(200.dp)
                .padding(bottom = 16.dp)
        )

        // ImageSwitcher-like Column
        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            Image(
                painter = painterResource(id = images[currentImageIndex]),
                contentDescription = "Switchable image",
                modifier = Modifier.size(200.dp)
            )
            Spacer(modifier = Modifier.height(8.dp))
            Button(
                onClick = {
                    currentImageIndex = (currentImageIndex + 1) % images.size
                    Toast.makeText(context, "Switched Image!", Toast.LENGTH_SHORT).show()
                },
                modifier = Modifier.padding(bottom = 24.dp)
            ) {
                Text("Switch Image")
            }
        }

        // Toggle Switch
        Row(verticalAlignment = Alignment.CenterVertically) {
            Text("Toggle: ", fontSize = 16.sp)
            Switch(
                checked = toggleState,
                onCheckedChange = {
                    toggleState = it
                    Toast.makeText(
                        context,
                        if (it) "Switch turned ON" else "Switch turned OFF",
                        Toast.LENGTH_SHORT
                    ).show()
                },
                modifier = Modifier.padding(start = 8.dp)
            )
        }
    }
}

