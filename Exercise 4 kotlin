package com.example.mainactivity

import android.os.Bundle
import android.widget.Toast
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.layout.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.res.painterResource
import androidx.compose.ui.tooling.preview.Preview
import androidx.compose.ui.unit.dp
import com.example.mainactivity.ui.theme.MainActivityTheme

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            MainActivityTheme {
                MainScreen()
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen() {
    // ✅ Context for Toast
    val context = LocalContext.current

    // ✅ State for ToggleButton
    var toggleState by remember { mutableStateOf(false) }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        // Standard Button
        Button(
            onClick = {
                Toast.makeText(context, "Button clicked!", Toast.LENGTH_SHORT).show()
            },
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Standard Button")
        }

        Spacer(modifier = Modifier.height(16.dp))

        // Image Button
        IconButton(
            onClick = {
                Toast.makeText(context, "Image button clicked!", Toast.LENGTH_SHORT).show()
            },
            modifier = Modifier.size(70.dp)
        ) {
            Icon(
                painter = painterResource(id = R.drawable.idonow),
                contentDescription = "Image Button",
                tint = Color.Unspecified
            )
        }

        Spacer(modifier = Modifier.height(16.dp))

        // Toggle Button (Switch)
        Row(
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text("Toggle: ")
            Switch(
                checked = toggleState,
                onCheckedChange = {
                    toggleState = it
                    Toast.makeText(
                        context,
                        if (it) "Switch turned ON" else "Switch turned OFF",
                        Toast.LENGTH_SHORT
                    ).show()
                }
            )
        }
    }
}

@Preview(showBackground = true)
@Composable
fun MainScreenPreview() {
    MainActivityTheme {
        MainScreen()
    }
}
